<% layout('layouts/boilerplate') %>

<div class="row justify-content-center py-4">
    <div class="col-md-6 col-lg-5">
        <div class="card p-4 p-md-5">
            <div class="text-center mb-4">
                <span class="brand-badge font-mono mb-2 d-inline-block">NEW USER</span>
                <h2 class="fw-bold mb-1">Create Account</h2>
                <p class="text-secondary small">Set up your private task management workspace</p>
            </div>

            <form action="/signup" method="POST" class="needs-validation" novalidate>
                <div class="mb-3">
                    <label for="username" class="form-label">Username</label>
                    <input type="text" name="username" id="username" class="form-control" required placeholder="Choose a username">
                    <div class="invalid-feedback">Please enter a username.</div>
                </div>

                <div class="mb-4">
                    <label for="password" class="form-label">Password</label>
                    <input type="password" name="password" id="password" class="form-control" required placeholder="Choose a secure password">
                    <div class="invalid-feedback">Please enter a password.</div>
                </div>

                <button class="btn btn-dark w-100 py-3 mb-3">Create Workspace Account &rarr;</button>
            </form>

            <p class="mt-2 text-center text-secondary small mb-0">
                Already have an account? <a href="/login" class="task-link fw-bold">Login here</a>
            </p>
        </div>
    </div>
</div>
