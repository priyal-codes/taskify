<% layout('layouts/boilerplate') %>

<div class="row justify-content-center py-4">
    <div class="col-md-6 col-lg-5">
        <div class="card p-4 p-md-5">
            <div class="text-center mb-4">
                <span class="brand-badge font-mono mb-2 d-inline-block">AUTHENTICATION</span>
                <h2 class="fw-bold mb-1">Welcome Back</h2>
                <p class="text-secondary small">Log in to access your monochrome workspace</p>
            </div>

            <% if (locals.error) { %>
                <div class="p-3 mb-4 border rounded-3 bg-secondary font-mono small text-center text-primary" role="alert">
                    <i class="fa-solid fa-circle-exclamation me-1"></i> <%= error %>
                </div>
            <% } %>

            <form action="/login" method="POST" class="needs-validation" novalidate>
                <div class="mb-3">
                    <label for="username" class="form-label">Username</label>
                    <input type="text" name="username" id="username" class="form-control" required placeholder="Enter your username">
                    <div class="invalid-feedback">Please enter a username.</div>
                </div>

                <div class="mb-4">
                    <label for="password" class="form-label">Password</label>
                    <input type="password" name="password" id="password" class="form-control" required placeholder="Enter password">
                    <div class="invalid-feedback">Please enter a password.</div>
                </div>

                <button class="btn btn-dark w-100 py-3 mb-3">Sign In &rarr;</button>
            </form>

            <p class="mt-2 text-center text-secondary small mb-0">
                Don't have an account? <a href="/signup" class="task-link fw-bold">Sign up here</a>
            </p>
        </div>
    </div>
</div>
