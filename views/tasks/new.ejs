<% layout("/layouts/boilerplate") -%>

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="mb-4">
            <a href="/tasks" class="btn btn-outline-dark btn-sm"><i class="fa-solid fa-arrow-left me-2"></i> Back to workspace</a>
        </div>

        <div class="card p-4">
            <h3 class="fw-bold mb-4">Create New Task</h3>
            <form method="POST" action="/tasks" class="needs-validation" novalidate>
                <div class="mb-3">
                    <label for="title" class="form-label">Task Title</label>
                    <input name="task[title]" id="title" placeholder="Enter task title..." type="text" class="form-control" required>
                    <div class="invalid-feedback">Please enter a task title.</div>
                </div>
                <div class="mb-4">
                    <label for="description" class="form-label">Description</label>
                    <textarea name="task[description]" id="description" placeholder="Enter task description (optional)..." rows="4" class="form-control"></textarea>
                </div>
                <button class="btn btn-dark w-100 py-3">Create Task</button>
            </form>
        </div>
    </div>
</div>
