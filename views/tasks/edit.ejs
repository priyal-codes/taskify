<% layout("/layouts/boilerplate") -%>

<div class="row justify-content-center py-3">
    <div class="col-lg-7">
        <div class="mb-4">
            <a href="/tasks/<%= task._id %>" class="btn btn-outline-dark btn-sm">
                <i class="fa-solid fa-arrow-left me-1"></i> Cancel
            </a>
        </div>

        <div class="card p-4 p-md-5">
            <div class="mb-4 border-bottom pb-3">
                <span class="status-badge <%= task.status.toLowerCase().replace(' ', '-') %> font-mono mb-2">EDITING TASK</span>
                <h3 class="fw-bold mb-1">Edit Task Details</h3>
                <p class="text-secondary small mb-0">Modify task title or description.</p>
            </div>

            <form method="POST" action="/tasks/<%= task._id %>?_method=PUT" class="needs-validation" novalidate>
                <div class="mb-4">
                    <label for="title" class="form-label">Task Title</label>
                    <input name="task[title]" id="title" value="<%= task.title %>" type="text" class="form-control" required>
                    <div class="invalid-feedback">Please enter a task title.</div>
                </div>

                <div class="mb-4">
                    <label for="description" class="form-label">Description</label>
                    <textarea name="task[description]" id="description" rows="5" class="form-control"><%= task.description %></textarea>
                </div>

                <div class="d-flex justify-content-end gap-2 pt-2 border-top">
                    <a href="/tasks/<%= task._id %>" class="btn btn-outline-dark">Cancel</a>
                    <button class="btn btn-dark px-4">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>
