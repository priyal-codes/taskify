<% layout("/layouts/boilerplate") -%>

<div class="row justify-content-center align-items-center py-5">
    <div class="col-lg-9 text-center py-4">
        <div class="mb-4">
            <span class="status-badge pending font-mono px-3 py-2">
                <i class="fa-solid fa-circle me-1" style="font-size: 0.4rem;"></i> MONOCHROME WORKSPACE V2.0
            </span>
        </div>
        <h1 class="display-3 fw-extrabold mb-4" style="letter-spacing: -0.04em; line-height: 1.1;">
            Simple task management.<br/>Refined in Black & White.
        </h1>
        <p class="lead text-secondary mx-auto mb-5" style="max-width: 620px; font-size: 1.15rem;">
            An ultra-clean, high-contrast workspace built to capture thoughts, organize Kanban flows, and drive relentless focus.
        </p>
        
        <div class="d-flex justify-content-center gap-3 flex-wrap mb-5">
            <a href="/tasks" class="btn btn-dark btn-lg px-4 py-3">
                <i class="fa-solid fa-arrow-right me-1"></i> Launch Workspace
            </a>
            <% if (!locals.currentUser) { %>
                <a href="/login" class="btn btn-outline-dark btn-lg px-4 py-3">
                    Sign In
                </a>
            <% } %>
        </div>

        <div class="row pt-5 justify-content-center text-start g-4 border-top">
            <div class="col-md-4">
                <div class="stat-box h-100">
                    <div class="mb-3">
                        <i class="fa-solid fa-square-poll-vertical fs-3"></i>
                    </div>
                    <h5 class="fw-bold mb-2">Kanban Board</h5>
                    <p class="text-secondary small mb-0">Visualize tasks in clean 3-column Kanban flow: Pending, In Progress, and Completed.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="stat-box h-100">
                    <div class="mb-3">
                        <i class="fa-solid fa-moon fs-3"></i>
                    </div>
                    <h5 class="fw-bold mb-2">Dark / Light Mode</h5>
                    <p class="text-secondary small mb-0">Seamlessly toggle between high-contrast dark and light monochrome themes with zero lag.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="stat-box h-100">
                    <div class="mb-3">
                        <i class="fa-solid fa-bolt fs-3"></i>
                    </div>
                    <h5 class="fw-bold mb-2">Fast Search & Filter</h5>
                    <p class="text-secondary small mb-0">Instantly search and filter tasks in real-time right from your workspace header.</p>
                </div>
            </div>
        </div>
    </div>
</div>